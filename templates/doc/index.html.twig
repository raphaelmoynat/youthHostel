            <pre class="bg-light p-3">
            {
                "room": 1,
                "pricePerNight": 45.5
            }
        </pre>
            <h6>Response Example:</h6>
            <pre class="bg-light p-3">
            {
                "id": 1,
                "room": {
                    "id": 1,
                    "name": "Room A"
                    "totalBeds": 3
                },
                "pricePerNight": 45.5,
                "isCleaned": true
            }
        </pre>
        </div>
    </div>

